OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# 设置为 true 可在无 API Key 时运行演示
MOCK_LLM=false

# ── Compute Service Embedding Backend ──
# "local"  -> sentence-transformers (真实语义模型，需 pip install sentence-transformers)
# "openai" -> OpenAI API (高质量，需有效 OPENAI_API_KEY)
# "mock"   -> 领域词典 + jieba 分词语义向量 (默认，无依赖，有真实语义区分度)
COMPUTE_EMBED_BACKEND=mock
COMPUTE_LOCAL_MODEL=all-MiniLM-L6-v2
COMPUTE_OPENAI_MODEL=text-embedding-3-small
