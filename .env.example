# ── LLM Provider ──
# 支持 OpenAI 兼容接口的提供商：openai / deepseek / kimi
LLM_PROVIDER=openai

# OpenAI 配置
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# DeepSeek 配置（兼容 OpenAI SDK）
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

EMBED_MODEL=text-embedding-3-small

# ── Compute Service Embedding Backend ──
# "local"   -> sentence-transformers (真实语义模型，需 pip install sentence-transformers)
# "openai"  -> OpenAI API (高质量，需有效 OPENAI_API_KEY)
# "keyword" -> 领域词典 + jieba 分词语义向量 (默认，无依赖，有真实语义区分度)
COMPUTE_EMBED_BACKEND=keyword
COMPUTE_LOCAL_MODEL=all-MiniLM-L6-v2
COMPUTE_OPENAI_MODEL=text-embedding-3-small

# ── Authentication ──
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# GitHub OAuth (可选，留空则禁用 GitHub 登录)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# ── Database ──
# 设为 true 启用 PostgreSQL 持久化，false 使用内存存储（默认，零依赖）
USE_DB=false
DATABASE_URL=postgresql://localhost:5432/cognitive_space
DB_SCHEMA_CORE=core
DB_SCHEMA_AUTH=auth
DB_SCHEMA_AGGREGATOR=aggregator

# Redis 预留（Generator 缓存，当前不启用）
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false
